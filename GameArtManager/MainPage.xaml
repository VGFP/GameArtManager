<Page
    x:Class="GameArtManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:GameArtManager.Core"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Background="{StaticResource PageBrush}" Padding="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Scan" Click="BtnScan_Click" />
            <AppBarButton Icon="Sync" Label="Auto-match" Click="BtnMatch_Click" />
            <AppBarButton Icon="Download" Label="Apply all" Click="BtnApplyAll_Click" />
            <AppBarButton Icon="Undo" Label="Restore all" Click="BtnRestoreAll_Click" />
            <AppBarButton Icon="Setting" Label="Settings" Click="BtnSettings_Click" />
            <AppBarButton x:Name="BtnCleanOrphans" Icon="Delete" Label="Clean orphans" Click="BtnCleanOrphans_Click" />
            <AppBarButton x:Name="BtnFixPermission" Icon="Permissions" Label="Fix permission"
                          Visibility="Collapsed" Click="BtnFixPermission_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarToggleButton x:Name="TglHideOrphaned" Label="Hide orphaned entries"
                                    IsChecked="True" Click="TglHideOrphaned_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Game list card -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="6">
                <ListView x:Name="GamesList" SelectionMode="Single"
                          SelectionChanged="GamesList_SelectionChanged"
                          ItemContainerStyle="{StaticResource RoundedListCardItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:GameVm">
                            <Grid Height="56" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6"
                                        Background="#2A3038" Padding="2">
                                    <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Detail pane: three distinct cards -->
            <ScrollViewer Grid.Column="1" x:Name="DetailPane" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="140" Height="140" CornerRadius="8" Background="#2A3038" Padding="6">
                                <Image x:Name="DetailThumb" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailId" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="DetailStatus" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="6">
                                    <Button x:Name="BtnApplyBest" Content="Apply best" Click="BtnApplyBest_Click" />
                                    <Button x:Name="BtnCustom" Content="Custom image…" Click="BtnCustom_Click" />
                                    <Button x:Name="BtnRestore" Content="Restore" Click="BtnRestore_Click" />
                                </StackPanel>
                                <Button x:Name="BtnFixMatch" Content="Wrong match? Fix…" Click="BtnFixMatch_Click"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SEARCH STEAMGRIDDB" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" PlaceholderText="Game name…" CornerRadius="6"
                                         KeyDown="SearchBox_KeyDown" />
                                <Button Grid.Column="1" Content="Search" Click="BtnSearch_Click" />
                            </Grid>
                            <Grid Height="110">
                                <ListView x:Name="SearchResults" SelectionMode="Single"
                                          SelectionChanged="SearchResults_SelectionChanged"
                                          ItemContainerStyle="{StaticResource RoundedListCardItem}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" CornerRadius="6">
                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="SearchLoading" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <ProgressRing Width="26" Height="26" IsActive="True" />
                                    <TextBlock Text="Searching…" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ARTWORK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <Grid Height="220">
                                <GridView x:Name="ArtResults" SelectionMode="Single"
                                          SelectionChanged="ArtResults_SelectionChanged"
                                          ItemContainerStyle="{StaticResource RoundedArtCardItem}">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ArtVm">
                                            <Border Width="120" Height="120" CornerRadius="10" Background="#2A3038"
                                                    BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1" Padding="4">
                                                <Image Stretch="Uniform" Source="{x:Bind Thumb, Mode=OneWay}" />
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel x:Name="ArtLoading" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <ProgressRing Width="34" Height="34" IsActive="True" />
                                    <TextBlock Text="Loading artwork…" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="ArtEmpty" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="No artwork available" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="Match this game or use the search above to pick one manually."
                                               FontSize="11" Foreground="{StaticResource FaintTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="BtnUseArt" Content="Use selected artwork" Click="BtnUseArt_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Progress" Width="22" Height="22" IsActive="False" />
            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="#B7BFC9" />
            <TextBlock Grid.Column="2" x:Name="VersionText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource FaintTextBrush}" />
        </Grid>
    </Grid>
</Page>
