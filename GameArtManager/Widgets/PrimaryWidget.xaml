<Page
    x:Class="GameArtManager.Widgets.PrimaryWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:GameArtManager.Core">
    <Grid Background="{StaticResource PageBrush}" Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- List-mode command bar (hidden while the cover picker is open) -->
        <CommandBar x:Name="MainBar" Grid.Row="0" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Icon="Refresh" Label="Scan" Click="BtnScan_Click" />
            <AppBarButton Icon="Sync" Label="Match" Click="BtnMatch_Click" />
            <AppBarButton Icon="Download" Label="Apply all" Click="BtnApplyAll_Click" />
            <AppBarButton Icon="Undo" Label="Restore all" Click="BtnRestoreAll_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="OpenFile" Label="Full app" Click="BtnOpenApp_Click" />
        </CommandBar>

        <!-- List mode: game list card fills the widget -->
        <Border x:Name="ListPane" Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4">
            <ListView x:Name="GamesList" SelectionMode="Single"
                      IsItemClickEnabled="True" ItemClick="GamesList_ItemClick"
                      SelectionChanged="GamesList_SelectionChanged"
                      ItemContainerStyle="{StaticResource RoundedListCardItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:GameVm">
                        <Grid Height="44" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="5" Background="#2A3038" Padding="1">
                                <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{x:Bind StatusBrush, Mode=OneWay}" Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Cover mode: artwork picker for one game. Entered by activating a list
             item; the Back button, gamepad B or Escape returns to the list. -->
        <Grid x:Name="DetailPane" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="10" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnBack" Click="BtnBack_Click" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Back" />
                        <TextBlock Text="Back to games" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="DetailTitle" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled">
                <StackPanel Spacing="8">
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="6" Background="#2A3038" Padding="2">
                                <Image x:Name="DetailThumb" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailStatus" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                    <Button x:Name="BtnApplyBest" Content="Apply best" Click="BtnApplyBest_Click" FontSize="12" />
                                    <Button x:Name="BtnRestore" Content="Restore" Click="BtnRestore_Click" FontSize="12" />
                                    <Button x:Name="BtnFixMatch" Content="Fix match…" Click="BtnFixMatch_Click" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" PlaceholderText="Search SteamGridDB…" FontSize="12" CornerRadius="6"
                                         KeyDown="SearchBox_KeyDown" />
                                <Button Grid.Column="1" Content="Go" Click="BtnSearch_Click" FontSize="12" />
                            </Grid>
                            <Grid Height="84">
                                <ListView x:Name="SearchResults" SelectionMode="Single"
                                          SelectionChanged="SearchResults_SelectionChanged" FontSize="12"
                                          ItemContainerStyle="{StaticResource RoundedListCardItem}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,3" CornerRadius="5">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="SearchLoading" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <ProgressRing Width="22" Height="22" IsActive="True" />
                                    <TextBlock Text="Searching…" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                            <Grid Height="150">
                                <GridView x:Name="ArtResults" SelectionMode="Single"
                                          SelectionChanged="ArtResults_SelectionChanged"
                                          ItemContainerStyle="{StaticResource RoundedArtCardItem}">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="core:ArtVm">
                                            <Border Width="96" Height="96" CornerRadius="8" Background="#2A3038"
                                                    BorderBrush="{StaticResource CardEdgeBrush}" BorderThickness="1" Padding="3">
                                                <Image Stretch="Uniform" Source="{x:Bind Thumb, Mode=OneWay}" />
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel x:Name="ArtLoading" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <ProgressRing Width="28" Height="28" IsActive="True" />
                                    <TextBlock Text="Loading artwork…" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ArtEmpty" Visibility="Collapsed" Text="No artwork available"
                                           FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Button x:Name="BtnUseArt" Content="Use selected artwork" Click="BtnUseArt_Click" FontSize="12"
                                    HorizontalAlignment="Left" />
                            <TextBlock FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                       Text="Custom images from disk: use the Full app button." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,6,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False" />
            <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                       Foreground="#B7BFC9" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" x:Name="VersionText" VerticalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource FaintTextBrush}" />
        </Grid>
    </Grid>
</Page>
