# Normalize text files to LF in the repo; check out as native.
* text=auto

# Windows-only scripts must stay CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binaries — never diff/normalize
*.png binary
*.ico binary
*.gif binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
*.pfx binary
*.cer binary
*.msix binary
*.appx binary
